# ==============================================================================
# LLM API Key Proxy (Rust) - Environment Variables
# ==============================================================================
# Copy this file to .env and replace placeholder values.

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
#HOST=127.0.0.1
#PORT=8000
#RUST_LOG=proxy_app=debug,tower_http=debug

# Required for admin routes.
#ADMIN_TOKEN=your-secret-admin-token

# ------------------------------------------------------------------------------
# Provider API keys
# ------------------------------------------------------------------------------
# Keys are discovered by the pattern {PROVIDER}_API_KEY_{N}.
# Provider names are lowercased by the Rust rotator.

#OPENAI_API_KEY_1=sk-your-openai-key
#ANTHROPIC_API_KEY_1=sk-ant-your-anthropic-key
#GEMINI_API_KEY_1=your-gemini-key
#OPENROUTER_API_KEY_1=your-openrouter-key
#FIREWORKS_API_KEY_1=your-fireworks-key
#NVIDIA_API_KEY_1=your-nvidia-key
#QWEN_API_KEY_1=your-qwen-key
#ZAI_API_KEY_1=your-zai-key
#IFLOW_API_KEY_1=your-iflow-key
#CHUTES_API_KEY_1=your-chutes-key
#NANOGPT_API_KEY_1=your-nanogpt-key
#OPENCODE_API_KEY_1=your-opencode-key
#FIRMWARE_API_KEY_1=your-firmware-key
#XAI_API_KEY_1=your-xai-key
#KILOCODE_API_KEY_1=your-kilocode-key

# Default User-Agent sent to upstream when client doesn't provide one.
# Matches Codex CLI format: codex_cli_rs/{version} ({os} {ver}; {arch})
# USER_AGENT=codex_cli_rs/0.45.0 (Windows 11; x86_64)

# ------------------------------------------------------------------------------
# Provider overrides
# ------------------------------------------------------------------------------
# Override provider base URL, auth type, model regexes, or timeout.
# Auth values: api_key, bearer, oauth.
# Model patterns are comma-separated Rust regexes.

#PROXY_OPENAI_URL=https://api.openai.com/v1
#PROXY_OPENAI_AUTH=api_key
#PROXY_OPENAI_MODELS=^(gpt|o1|o3|o4)([-/].*)?$,^text-embedding-.*,^dall-e-.*
#PROXY_OPENAI_TIMEOUT=60

#PROXY_ANTHROPIC_URL=https://api.anthropic.com/v1
#PROXY_ANTHROPIC_AUTH=api_key
#PROXY_ANTHROPIC_MODELS=^claude[-/].*
#PROXY_ANTHROPIC_TIMEOUT=60

#PROXY_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
#PROXY_GEMINI_AUTH=api_key
#PROXY_GEMINI_MODELS=^(models/)?gemini[-/].*
#PROXY_GEMINI_TIMEOUT=60

# ------------------------------------------------------------------------------
# Performance / reliability tuning
# ------------------------------------------------------------------------------
# Same-key retries on stale/dead pooled connections before rotating credentials.
# These errors occur before the upstream commits the request (dead keep-alive
# conn, connect failure, reset/broken-pipe during write), so retrying is safe.
# Mirrors bifrost's maxStaleConnRetries. Default: 3.
#PROXY_MAX_STALE_CONNECTION_RETRIES=3

# Credential selection strategy across the keys of a provider.
# Values: least-loaded (default) | round-robin | weighted-random
#PROXY_SELECTION_STRATEGY=least-loaded
